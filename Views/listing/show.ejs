<% layout("layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-3">
  <h3>listing Details</h3>
  </div>
  <div class="card col-6 offset-3 show-card">
        <img src="<%= listings.image %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
        <p class="card-text">
          <b><%= listings.title %></b></br>
          <%= listings.description %> <br>
           ₹ <%= listings.price.toLocaleString("en-IN") %> <br>
           <%= listings.location %> <br>
           <%= listings.country %>
        </p>
      </div>
    </div> 
      <br/> 
</div>
<div class="btns">
  <a href="/listings/<%= listings._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
  <form method="post" action="/listings/<%= listings._id %>?_method=DELETE">
    <button class="btn btn-dark offset-5">Delete</button>
  </form>

  <div class="col-8 offset-3 mb-3">
    <hr/>
    <h4>Leave a Review</h4>
    <form>
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" >
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control">
      </div>
      <button class="btn btn-outlint-dark">Submit</button>
    </form>
  </div>
</div>
